# ─────────────────────────────────────────────────
#  InstaBot — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-long-random-string

# ── MiniMax AI (for comment & caption generation) ──────────────────────────
# Get your keys at: https://www.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_MODEL=abab6.5s-chat

# ── Instagram rate limits (adjust to stay safe) ────────────────────────────
# Minimum seconds between Instagram actions (likes, comments, etc.)
INSTAGRAM_DELAY_MIN=30
INSTAGRAM_DELAY_MAX=120

# Per-hour limits — KEEP THESE CONSERVATIVE to avoid bans
MAX_LIKES_PER_HOUR=30
MAX_COMMENTS_PER_HOUR=10
MAX_POSTS_PER_DAY=6
